{
  "$id": "https://safe-to-act.local/schemas/execution_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "action_log_entries": {
      "type": "integer"
    },
    "artifacts": {
      "type": "array"
    },
    "env_id": {
      "type": "string"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "evaluated_at": {
      "type": "string"
    },
    "execution_layer": {
      "enum": [
        "tool_augmented"
      ],
      "type": "string"
    },
    "run_trace": {
      "type": "object"
    },
    "run_trace_path": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "scoring_errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "scoring_status": {
      "enum": [
        "not_scored",
        "pass_gold",
        "fail_gold",
        "skipped"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "pass_contract",
        "fail_contract",
        "pass_execution_record",
        "fail_execution_record",
        "pass_gold_score",
        "fail_gold_score",
        "skip_legacy"
      ],
      "type": "string"
    },
    "workspace_diff_counts": {
      "properties": {
        "added": {
          "type": "integer"
        },
        "deleted": {
          "type": "integer"
        },
        "modified": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "workspace_diff_path": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "env_id",
    "status",
    "evaluated_at",
    "execution_layer",
    "scoring_status",
    "errors"
  ],
  "title": "Tool-Augmented Safe-to-Act Evaluation Record",
  "type": "object"
}
