{
  "$id": "https://safe-to-act.local/schemas/state_action_execution_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Execution record for evidence-gated single-commit evaluation. The agent records multiple low-risk INFO_CALL events from distinct tools followed by exactly one final CONSEQUENTIAL_CALL attempt. ALLOW/DEFER/BLOCK is produced by the evaluator, not by the agent.",
  "properties": {
    "env_id": {
      "minLength": 1,
      "type": "string"
    },
    "episode_id": {
      "minLength": 1,
      "type": "string"
    },
    "events": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "arguments": {
            "type": "object"
          },
          "call_id": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "tool": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "INFO_CALL",
              "CONSEQUENTIAL_CALL"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "tool",
          "arguments"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "runner": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "env_id",
    "episode_id",
    "events"
  ],
  "title": "SafeActBench v1 Single-Commit Execution Record",
  "type": "object"
}
