{
  "$id": "safeact://schemas/domain_action_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_time": {
      "format": "date-time",
      "type": "string"
    },
    "actions": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "action_id": {
            "type": "string"
          },
          "action_output_schema": {
            "type": "object"
          },
          "allowed_statuses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "input_schema": {
            "type": "object"
          },
          "match_arguments": {
            "type": "object"
          },
          "preview_output_schema": {
            "type": "object"
          },
          "required_states": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "resource_id": {
            "type": "string"
          },
          "set_fields": {
            "type": "object"
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "tool",
          "match_arguments",
          "resource_id",
          "allowed_statuses",
          "required_states",
          "set_fields",
          "input_schema",
          "preview_output_schema",
          "action_output_schema"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "env_id": {
      "enum": [
        "smart_home_agent",
        "healthcare_operations_agent"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "world_snapshot_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "env_id",
    "world_snapshot_version",
    "action_time",
    "actions"
  ],
  "title": "SafeActBench consequential action registry",
  "type": "object"
}
