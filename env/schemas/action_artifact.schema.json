      "minLength": 1,
      "type": "string"
    },
    "artifact_type": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "created_by_tool": {
      "minLength": 1,
      "type": "string"
