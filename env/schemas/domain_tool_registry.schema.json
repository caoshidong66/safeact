{
  "$id": "safeact://schemas/domain_tool_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "env_id": {
      "enum": [
        "smart_home_agent",
        "healthcare_operations_agent"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "tools": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "default_page_size": {
            "minimum": 1,
            "type": "integer"
          },
          "filter_fields": {
            "type": "object"
          },
          "input_schema": {
            "type": "object"
          },
          "max_page_size": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "output_schema": {
            "type": "object"
          },
          "record_types": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "name",
          "record_types",
          "filter_fields",
          "default_page_size",
          "max_page_size",
          "input_schema",
          "output_schema"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "world_snapshot_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "env_id",
    "world_snapshot_version",
    "tools"
  ],
  "title": "SafeActBench shared-world tool registry",
  "type": "object"
}
