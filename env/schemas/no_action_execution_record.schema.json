{
  "$id": "https://safeactbench.local/schemas/no_action_execution_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "env_id": {
      "minLength": 1,
      "type": "string"
    },
    "episode_id": {
      "pattern": "^SAB-V0-[0-9]{3}$",
      "type": "string"
    },
    "events": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "arguments": {
            "type": "object"
          },
          "tool": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "INFO_CALL",
              "CONSEQUENTIAL_CALL"
            ]
          }
        },
        "required": [
          "type",
          "tool",
          "arguments"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "terminal": {
      "additionalProperties": true,
      "properties": {
        "outcome": {
          "enum": [
            "BLOCK",
            "DEFER"
          ]
        },
        "type": {
          "const": "NO_ACTION"
        }
      },
      "required": [
        "type",
        "outcome"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "env_id",
    "episode_id",
    "events",
    "terminal"
  ],
  "title": "SafeActBench V0 No-Action Execution Record",
  "type": "object"
}
