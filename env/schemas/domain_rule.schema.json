{
  "$id": "safeact://schemas/domain_rule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "management": {
      "required": [
        "effect"
      ],
      "type": "object"
    },
    "override_policy": {
      "required": [
        "permitted"
      ],
      "type": "object"
    },
    "predicate": {
      "minProperties": 1,
      "type": "object"
    },
    "required_evidence": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "arguments": {
            "type": "object"
          },
          "max_age_seconds": {
            "minimum": 0,
            "type": "integer"
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "arguments"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "rule_id": {
      "minLength": 1,
      "type": "string"
    },
    "rule_type": {
      "enum": [
        "dependency",
        "mutex",
        "interlock",
        "authorization",
        "freshness",
        "privacy",
        "resource_constraint",
        "interaction",
        "duplicate_therapy",
        "contraindication",
        "monitoring",
        "timing"
      ]
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "enum": [
        "active",
        "retired",
        "draft"
      ]
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "rule_type",
    "version",
    "effective_period",
    "status",
    "scope",
    "subjects",
    "predicate",
    "required_evidence",
    "management",
    "severity",
    "override_policy",
    "source_refs",
    "last_reviewed_at"
  ],
  "title": "SafeActBench structured domain rule",
  "type": "object"
}
