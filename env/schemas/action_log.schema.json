{
  "$id": "https://safe-to-act.local/schemas/action_log.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "args": {
      "type": "object"
    },
    "artifact_refs": {
      "items": {
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "artifact_type",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "env_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "result_status": {
      "enum": [
        "ok",
        "error"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "summary": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "tool_name": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "env_id",
    "tool_name",
    "args",
    "result_status",
    "summary",
    "artifact_refs"
  ],
  "title": "Safe-to-Act Mock Tool Action Log Entry",
  "type": "object"
}
