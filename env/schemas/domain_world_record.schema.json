{
  "$id": "safeact://schemas/domain_world_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "effective_period": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "fresh_until": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "record_type": {
      "minLength": 1,
      "type": "string"
    },
    "record_version": {
      "minimum": 1,
      "type": "integer"
    },
    "refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "record_type",
    "record_version",
    "status",
    "observed_at",
    "effective_period",
    "source_refs",
    "schema_version"
  ],
  "title": "SafeActBench shared-world record",
  "type": "object"
}
